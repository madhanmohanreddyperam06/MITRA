# Application Environment
APP_ENV=production
DEBUG=false

# Database Configuration (Railway MySQL)
# Use Railway's MYSQL_URL variable expansion
DATABASE_URL=mysql+pymysql://${MYSQLUSER}:${MYSQLPASSWORD}@${RAILWAY_TCP_PROXY_DOMAIN}:${RAILWAY_TCP_PROXY_PORT}/${MYSQLDATABASE}

# Authentication Configuration
# IMPORTANT: Generate a secure random key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
# Set to your frontend domain in production
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.railway.app

# NLP Configuration
SPACY_MODEL=en_core_web_sm
CONFIDENCE_THRESHOLD=0.5

# Chat Configuration
MAX_CONVERSATION_HISTORY=10
CHAT_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
