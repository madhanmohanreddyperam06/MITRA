# Application Environment
APP_ENV=development
DEBUG=true

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://mitra_user:password@localhost:3306/mitra_db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Authentication Configuration
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NLP Configuration
SPACY_MODEL=en_core_web_sm
CONFIDENCE_THRESHOLD=0.5

# Chat Configuration
MAX_CONVERSATION_HISTORY=10
CHAT_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
