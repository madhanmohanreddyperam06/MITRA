# Application Environment
APP_ENV=development
DEBUG=false

# Database Configuration (Cloud MySQL)
# MITRA expects DATABASE_URL in the format: mysql+pymysql://<username>:<password>@<host>:<port>/<database>

# Option 1: Direct DATABASE_URL (Recommended for Railway)
# Railway provides MYSQL_URL which can be mapped to DATABASE_URL
# In Railway dashboard, set DATABASE_URL to: mysql+pymysql://$MYSQLUSER:$MYSQLPASSWORD@$MYSQLHOST:$MYSQLPORT/$MYSQLDATABASE
# Or use the Railway MYSQL_URL directly and convert mysql:// to mysql+pymysql://
DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:<port>/<database>

# Option 2: Railway Individual Variables (Alternative)
# If you prefer to use Railway's individual variables, set DATABASE_URL as:
# DATABASE_URL=mysql+pymysql://${MYSQLUSER}:${MYSQLPASSWORD}@${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}
# Railway provides: MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD, MYSQL_URL

# Example for Railway:
# DATABASE_URL=mysql+pymysql://railway_user:secure_password@containers-us-west-1.railway.app:3306/railway

# Example for local development:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/mitra_db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
# Production: Comma-separated list of allowed origins
# Development: http://localhost:8501
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Authentication Configuration
# PRODUCTION: MUST use a secure, randomly generated secret key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NLP Configuration
SPACY_MODEL=en_core_web_sm
CONFIDENCE_THRESHOLD=0.5

# Chat Configuration
MAX_CONVERSATION_HISTORY=10
CHAT_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
